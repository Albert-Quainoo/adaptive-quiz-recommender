# AppSettings.from_sources() requires these three keys to exist, but for the
# real multi-course app (app/main.py) their values are never actually used:
# build_controller_for_course() overrides bkt_model_path/model_version/
# approved_bank_path per course from that course's own manifest
# (authoring/replenishment/manifests/*.json) the moment a learner selects a
# course. Only a placeholder is needed here -- do not read these values as
# "the BKT model version in production".
QUIZ_APPROVED_BANK_PATH = "outputs/approved_banks/pilot-approved-bank-43-v1.jsonl"
QUIZ_BKT_MODEL_PATH = "outputs/bkt_dev_model_v6.pkl"
QUIZ_BKT_MODEL_VERSION = "bkt-synthetic-v6"
QUIZ_DATABASE_URL = "SUPABASE_POSTGRES_CONNECTION_STRING"
QUIZ_INITIAL_MASTERY_PROBABILITY = "0.20"
