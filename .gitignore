!outputs/.gitkeep
!logs/.gitkeep

# Approved question bank: the one outputs/ artifact production runtime
# actually depends on (QUIZ_APPROVED_BANK_PATH, the replenishment
# active-bank pointer). Tracked so a fresh clone/deploy has it; everything
# else under outputs/ (batches, reviews, models, DBs) stays ignored.
!outputs/approved_banks/
!outputs/approved_banks/*.jsonl
!outputs/approved_banks/*-validation.json
!outputs/approved_banks/*-active-bank.json

# BKT model artifact the deployed app depends on (QUIZ_BKT_MODEL_PATH) --
# same rationale as outputs/approved_banks/ above. Other outputs/bkt_*
# checkpoints (v1-v3, the undated default) stay ignored.
!outputs/bkt_dev_model_v4.pkl
!outputs/bkt_dev_model_v4.metadata.json
!outputs/bkt_dev_model_v4.pkl.sha256

# intro-ai's active BKT model (extends v4's moderated-pilot profile with
# AI-FND-03/AI-FND-04, then corrected guesses 0.40 -> 0.25 to match the
# real 4-option chance rate) -- same rationale as bkt_dev_model_v4 above.
# v4 stays tracked too: other tests/fixtures still pin it directly. v5 is
# superseded (guesses=0.40, never pinned elsewhere) and no longer tracked.
!outputs/bkt_dev_model_v6.pkl
!outputs/bkt_dev_model_v6.metadata.json
!outputs/bkt_dev_model_v6.pkl.sha256

# Cold-start BKT models each new course's manifest.bkt_model_path points
# to -- same rationale as bkt_dev_model_v4 above. v2 corrects guesses
# 0.40 -> 0.25 (true chance for this project's 4-option items); v1 is
# superseded and no longer tracked.
!outputs/bkt_dsa_model_v2.pkl
!outputs/bkt_dsa_model_v2.metadata.json
!outputs/bkt_linear_algebra_model_v2.pkl
!outputs/bkt_linear_algebra_model_v2.metadata.json
!outputs/bkt_database_systems_model_v2.pkl
!outputs/bkt_database_systems_model_v2.metadata.json

# Misc
.python-version

# Taxonomy file
TAXONOMY.docx

#SQlite runtime paths
data/adaptive_quiz.sqlite3
data/adaptive_quiz.sqlite3-shm
data/adaptive_quiz.sqlite3-wal

