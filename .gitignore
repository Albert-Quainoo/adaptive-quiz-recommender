# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Notebook checkpoints
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
.streamlit/secrets.toml

# IDE files
.vscode/
.idea/

# Raw and processed datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model files and checkpoints
outputs/*
checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# Training logs and tracking
logs/*
wandb/
runs/

# Evaluation results
evaluation/results/*
!evaluation/results/.gitkeep

# Hugging Face cache
.cache/
huggingface/
hf_cache/

# OS files
.DS_Store
Thumbs.db

# Kaggle and temporary files
kaggle.json
*.tar.gz
*.zip

!outputs/.gitkeep
!logs/.gitkeep

# Approved question bank: the one outputs/ artifact production runtime
# actually depends on (QUIZ_APPROVED_BANK_PATH, the replenishment
# active-bank pointer). Tracked so a fresh clone/deploy has it; everything
# else under outputs/ (batches, reviews, models, DBs) stays ignored.
!outputs/approved_banks/
!outputs/approved_banks/*.jsonl
!outputs/approved_banks/*-validation.json
!outputs/approved_banks/*-active-bank.json

# Misc
.python-version

# Taxonomy file
TAXONOMY.docx

#SQlite runtime paths
data/adaptive_quiz.sqlite3
data/adaptive_quiz.sqlite3-shm
data/adaptive_quiz.sqlite3-wal

